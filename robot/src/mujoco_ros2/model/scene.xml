<mujoco model="ur5e_scene">

  <!-- Include robot arm -->
  <include file="ur5e.xml"/>

  <statistic center="0.4 0 0.4" extent="0.8"/>

  <!-- Balanced lighting and visuals -->
  <visual>
    <headlight diffuse="0.8 0.8 0.8" ambient="0.25 0.25 0.25" specular="0.4 0.4 0.4"/>
    <rgba haze="0.1 0.15 0.2 1"/> <!-- soft blue-gray haze -->
    <global azimuth="125" elevation="-25"/>
  </visual>

  <asset>
    <!-- Softer blue gradient background -->
    <texture type="skybox" builtin="gradient" rgb1="0.55 0.7 0.85" rgb2="0.1 0.15 0.2"
            width="512" height="3072"/>

    <!-- Ground / floor texture -->
    <texture type="2d" name="groundplane" builtin="checker" rgb1="0.25 0.25 0.25" rgb2="0.15 0.15 0.15"
            mark="edge" markrgb="0.4 0.4 0.4" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="6 6" reflectance="0.1"/>

    <!-- Conveyor -->
    <texture file="textures/conveyor.png" type="2d" name="conveyorbelt"/>
    <material name="conveyor" reflectance="0.15" texrepeat="4 5" texture="conveyorbelt" texuniform="true"/>

    <!--
    <mesh name="worker_mesh" file="meshes/utility_box_02_4k.obj"/> 
    -->

    <!-- Materials -->
    <material name="black_box" rgba="0.05 0.05 0.05 1" reflectance="0.05" shininess="0.2"/>
    <material name="metal_sheet" rgba="0.7 0.7 0.75 1" reflectance="0.4" shininess="0.6"/>
    <material name="dark_metal" rgba="0.2 0.2 0.22 1" reflectance="0.3" shininess="0.5"/>
    <material name="cardboard" rgba="0.7 0.6 0.45 1" reflectance="0.05" shininess="0.1"/>
    <material name="safety_yellow" rgba="1 0.85 0 1" reflectance="0.2" shininess="0.3"/>
    <material name="safety_black" rgba="0.1 0.1 0.1 1" reflectance="0.1" shininess="0.2"/>
    <material name="red_toolbox" rgba="0.75 0.1 0.1 1" reflectance="0.4" shininess="0.5"/>
    <material name="orange" rgba="0.9 0.5 0.1 1" reflectance="0.2" shininess="0.3"/>
  </asset>

  <worldbody>
    <!-- Overhead light -->
    <light pos="0 0 2.0" dir="0 0 -1" diffuse="1 1 1" specular="0.3 0.3 0.3" directional="true"/>

    <!-- Floor plane -->
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <!-- Table under the conveyor -->
    <body name="table" pos="0.5 0.3 -0.05">
      <!-- Table top -->
      <geom name="table_top" type="box" size="0.35 1.0 0.08" rgba="0.5 0.5 0.5 1" material="dark_metal"/>
    </body>

    <!-- Conveyor belt -->
    <body name="conveyor_floor" pos="0.5 0.3 0.035">
      <geom name="conveyor_geom" type="plane" size="0.35 1.0 0.01" material="conveyor" friction="1 1 1" contype="0" conaffinity="0"/>
    </body>

    <!-- Black box fully on top of belt -->
    <body name="box" pos="0.5 -0.5 0.05">
      <joint name="box_slide" type="slide" axis="0 1 0" limited="true" range="0 1.5"/>
      <geom type="box" size="0.25 0.15 0.02" mass="0.1" material="black_box"/>
    </body>


    <!--
    <body name="worker" pos="1.0 -0.3 1.0">
      <geom type="mesh" mesh="worker_mesh" size="0.1 0.1 0.02" rgba="0.4 0.3 0.2 1"/>
    </body>
    -->


    <!-- 1. RED TOOLBOX -->
    <body name="toolbox" pos="-0.99 -0.55 0.002">
      <!-- Main toolbox body -->
      <geom type="box" size="0.12 0.08 0.08" material="red_toolbox" contype="0" conaffinity="0"/>
      <!-- Handle on top -->
      <geom type="box" size="0.08 0.015 0.02" pos="0 0 0.1" rgba="0.15 0.15 0.15 1" contype="0" conaffinity="0"/>
      <!-- Drawer details -->
      <geom type="box" size="0.11 0.002 0.03" pos="0 -0.082 0.04" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>
      <geom type="box" size="0.11 0.002 0.03" pos="0 -0.082 -0.02" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>
    </body>

    <!-- 2. CARDBOARD BOXES STACK -->
    <body name="cardboard_stack" pos="1.2 1.0 0.1"> 
      <geom type="box" size="0.14 0.14 0.12" material="cardboard" contype="0" conaffinity="0"/>
      <geom type="box" size="0.12 0.13 0.1" pos="0.02 -0.02 0.22" material="cardboard" contype="0" conaffinity="0"/>
      <geom type="box" size="0.1 0.11 0.09" pos="-0.01 0.01 0.41" material="cardboard" contype="0" conaffinity="0"/>
      <geom type="box" size="0.14 0.01 0.001" pos="0 0 0.121" rgba="0.7 0.5 0.3 1" contype="0" conaffinity="0"/>
    </body>

    <!-- 3. FLOOR SAFETY SIGN -->
    <body name="floor_warning" pos="-0.05 0.95 0.002">
      <geom type="box" size="0.15 0.15 0.001" material="safety_yellow" contype="0" conaffinity="0"/>
      <geom type="box" size="0.13 0.02 0.002" quat="0.924 0 0 0.383" material="safety_black" contype="0" conaffinity="0"/>
      <geom type="box" size="0.13 0.02 0.002" quat="0.924 0 0 -0.383" material="safety_black" contype="0" conaffinity="0"/>
    </body>


    <!-- 4. SCATTERED CUT METAL PARTS -->
    <body name="cut_parts_area" pos="1.3 0.3 0.005">
      <!-- Circular cut part -->
      <geom type="cylinder" size="0.055 0.003" pos="0 0 0" material="metal_sheet" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.025 0.004" pos="0 0 0" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>
      
      <!-- Rectangular bracket -->
      <geom type="box" size="0.08 0.04 0.003" pos="0.15 0.1 0" material="metal_sheet" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.012 0.004" pos="0.08 0.1 0" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.012 0.004" pos="0.22 0.1 0" rgba="0.1 0.1 0.1 1" contype="0" conaffinity="0"/>
      
      <!-- Small square part -->
      <geom type="box" size="0.045 0.045 0.003" pos="-0.12 0.15 0" material="metal_sheet" contype="0" conaffinity="0"/>
    </body>

    <!-- 5. ORANGE TRAFFIC CONES -->
    <body name="cone_left" pos="-0.9 0.8 0.08">
      <geom type="cylinder" size="0.04 0.08" material="orange" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.045 0.005" pos="0 0 -0.075" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>
      <!-- White stripe -->
      <geom type="cylinder" size="0.041 0.015" pos="0 0 0.03" rgba="0.95 0.95 0.95 1" contype="0" conaffinity="0"/>
    </body>

    <body name="cone_right" pos="1.1 -0.5 0.08">
      <geom type="cylinder" size="0.04 0.08" material="orange" contype="0" conaffinity="0"/>
      <geom type="cylinder" size="0.045 0.005" pos="0 0 -0.075" rgba="0.2 0.2 0.2 1" contype="0" conaffinity="0"/>
      <!-- White stripe -->
      <geom type="cylinder" size="0.041 0.015" pos="0 0 0.03" rgba="0.95 0.95 0.95 1" contype="0" conaffinity="0"/>
    </body>

    <!-- 6. cut objects) -->
    <body name="cube_1" pos="-0.4 1.2 0.015">
      <geom type="box" size="0.09 0.09 0.09" material="dark_metal" contype="0" conaffinity="0"/>
    </body>

    <body name="cube_2" pos="-0.9 0.6 0.02">
      <geom type="box" size="0.04 0.04 0.04" material="metal_sheet" contype="0" conaffinity="0"/>
    </body>

    <body name="cube_3" pos="-0.7 0.9 0.018">
      <geom type="box" size="0.035 0.035 0.035" rgba="0.5 0.5 0.55 1" contype="0" conaffinity="0"/>
    </body>

    <!-- 7. PALLET in far corner -->
    <body name="wooden_pallet" pos="-0.09 -0.6 0.04">
      <!-- Pallet slats -->
      <geom type="box" size="0.15 0.12 0.03" rgba="0.55 0.4 0.25 1" contype="0" conaffinity="0"/>
      <geom type="box" size="0.02 0.12 0.025" pos="-0.1 0 -0.005" rgba="0.45 0.35 0.2 1" contype="0" conaffinity="0"/>
      <geom type="box" size="0.02 0.12 0.025" pos="0.1 0 -0.005" rgba="0.45 0.35 0.2 1" contype="0" conaffinity="0"/>
    </body>

  </worldbody>

</mujoco>
